PORT=5000
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/pos_db?retryWrites=true&w=majority
JWT_ACCESS_SECRET=change-this-to-a-random-32-char-secret-key
JWT_REFRESH_SECRET=change-this-to-another-random-32-char-secret-key
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173
